{
  "模式名称": "诈骗实体类型体系",
  "版本": "0.1",
  "实体类型数量": 17,
  "实体类型": [
    {
      "标准ID": "CASE",
      "名称": "案件",
      "定义": "当前案件或对话记录",
      "示例": [
        "case_000001",
        "r4"
      ]
    },
    {
      "标准ID": "PERSON",
      "名称": "人员",
      "定义": "真实人员、匿名参与者或对话参与者",
      "示例": [
        "报警人",
        "对方",
        "A",
        "B"
      ]
    },
    {
      "标准ID": "ROLE",
      "名称": "身份角色",
      "定义": "真实身份或被冒充的职业、身份角色",
      "示例": [
        "警察",
        "快递客服",
        "投资导师"
      ]
    },
    {
      "标准ID": "ORGANIZATION",
      "名称": "机构",
      "定义": "公司、银行、政府部门等组织",
      "示例": [
        "深圳市公安局",
        "中国农业银行"
      ]
    },
    {
      "标准ID": "PLATFORM",
      "名称": "平台",
      "定义": "综合平台、社交、支付或游戏渠道",
      "示例": [
        "微信",
        "QQ",
        "支付宝",
        "第五人格"
      ]
    },
    {
      "标准ID": "APP",
      "名称": "应用程序",
      "定义": "需要安装或使用的应用程序",
      "示例": [
        "公安通APP",
        "美ONE APP"
      ]
    },
    {
      "标准ID": "GROUP",
      "名称": "群聊",
      "定义": "社交软件中的群组",
      "示例": [
        "QQ群",
        "微信群"
      ]
    },
    {
      "标准ID": "ACCOUNT",
      "名称": "账户",
      "定义": "银行卡、收款账户或社交账号",
      "示例": [
        "银行卡号",
        "QQ号"
      ]
    },
    {
      "标准ID": "AMOUNT",
      "名称": "金额",
      "定义": "货币金额或损失数值",
      "示例": [
        "19999元",
        "20万元"
      ]
    },
    {
      "标准ID": "PHONE",
      "名称": "电话号码",
      "定义": "电话号码或来电号码",
      "示例": [
        "0755开头的号码"
      ]
    },
    {
      "标准ID": "URL",
      "名称": "网址链接",
      "定义": "网址、下载链接或网页地址",
      "示例": [
        "下载链接",
        "涉案网址"
      ]
    },
    {
      "标准ID": "CREDENTIAL",
      "名称": "身份凭证",
      "定义": "身份信息、密码或验证凭证",
      "示例": [
        "身份证",
        "验证码",
        "银行卡密码"
      ]
    },
    {
      "标准ID": "DOCUMENT",
      "名称": "文件材料",
      "定义": "文件、截图或证明材料",
      "示例": [
        "通缉令截图",
        "结清证明"
      ]
    },
    {
      "标准ID": "TIME",
      "名称": "时间",
      "定义": "日期、时间点或时间段",
      "示例": [
        "2022年11月28日16时30分"
      ]
    },
    {
      "标准ID": "LOCATION",
      "名称": "地点",
      "定义": "案件发生地、居住地或行政区域",
      "示例": [
        "家中",
        "南京建邺区"
      ]
    },
    {
      "标准ID": "PRODUCT_SERVICE",
      "名称": "产品服务",
      "定义": "商品、服务、工作、贷款或投资产品",
      "示例": [
        "免费皮肤",
        "点赞工作",
        "贷款"
      ]
    },
    {
      "标准ID": "OTHER",
      "名称": "其他",
      "定义": "确需保留但无法归入其他类型的对象",
      "示例": [
        "二维码",
        "紧急调查页面"
      ]
    }
  ],
  "人员角色数量": 5,
  "人员角色": [
    {
      "标准ID": "SUSPECT",
      "名称": "疑似诈骗者",
      "定义": "根据全文判断为实施或协助实施诈骗的一方"
    },
    {
      "标准ID": "VICTIM",
      "名称": "受害人",
      "定义": "被骗、被诱导或遭受资金损失的一方"
    },
    {
      "标准ID": "IMPERSONATED_PARTY",
      "名称": "被冒充方",
      "定义": "身份、名义或机构代表身份被冒用的一方"
    },
    {
      "标准ID": "OTHER",
      "名称": "其他人员",
      "定义": "参与事件但不属于上述角色的人员"
    },
    {
      "标准ID": "UNKNOWN",
      "名称": "未知",
      "定义": "现有证据不足以可靠判断角色"
    }
  ],
  "共指消解规则": {
    "同一对象的不同表述使用同一实体ID": true,
    "禁止硬编码代词指向": true,
    "存在歧义时禁止强制合并": true,
    "自动接受置信度阈值": 0.85,
    "第二模型复核最低阈值": 0.6,
    "低于该阈值转人工复核": 0.6
  }
}
